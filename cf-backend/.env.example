# KingShortID API — Environment Variables (VPS Deployment)
# Salin file ini ke .env.production dan isi dengan nilai asli dari Coolify dashboard.
# JANGAN commit .env.production ke Git!

PORT=3000
NODE_ENV=production

# JWT — Generate dengan: openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_MINIMAL_48_KARAKTER

# Admin API Key — Generate dengan: openssl rand -hex 24
ADMIN_API_KEY=GANTI_DENGAN_API_KEY_BARU

# Firebase untuk push notifications
FIREBASE_SERVICE_ACCOUNT=GANTI_DENGAN_JSON_SERVICE_ACCOUNT_FIREBASE

# Supabase (self-hosted on Coolify) — lihat Coolify dashboard
SUPABASE_URL=http://supabasekong-XXXX.IP_VPS.sslip.io
SUPABASE_DB_PASSWORD=GANTI_DENGAN_PASSWORD_SUPABASE

# Direct DB connection string (opsional, jika pakai drizzle langsung)
# DATABASE_URL=postgresql://supabase_admin:PASSWORD@supabase-db-XXXX:5432/postgres
